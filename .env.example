# =============================================================
# 世界文学名著时空地图 — 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# 一键启动脚本（Start-Literary-Atlas.command）会自动读取 .env；
# .env 未设置的变量将使用下方注释中说明的默认值。
# 本项目为本地演示，无真实敏感信息；如未来引入真实密码，
# 请只写入 .env（已被 git 忽略），不要提交到仓库。
# =============================================================

# ---------- 本地开发栈（Homebrew Postgres，一键启动脚本使用） ----------

# 本地 Postgres 连接串。默认使用当前 macOS 用户名免密连接本机库：
#   postgresql://<当前用户名>@localhost:5432/literary_atlas
# 如需自定义（例如另一个用户/端口），取消注释并修改：
# ATLAS_LOCAL_DATABASE_URL=postgresql://llmacbookpro@localhost:5432/literary_atlas

# API 监听端口（默认 4000）
# API_PORT=4000

# Web 开发服务器端口（默认 5173）
# WEB_PORT=5173

# 前端访问 API 的地址（默认 http://localhost:4000）
# VITE_API_URL=http://localhost:4000

# ---------- Docker 旧栈（docker compose up 使用，可与本地栈二选一） ----------
# 注意：Docker 栈同样占用 4000/5432 端口，与本地栈冲突时需 docker compose down。

POSTGRES_DB=literary_atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_local_only
# 下面这条 DATABASE_URL 仅供 Docker 栈内使用；本地一键启动脚本
# 不读取它（本地脚本只认 ATLAS_LOCAL_DATABASE_URL）。
DATABASE_URL=postgresql://atlas:atlas_local_only@localhost:5432/literary_atlas
VITE_API_URL=http://localhost:4000
